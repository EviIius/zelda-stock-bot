# Copy this file to ".env" and fill it in. The .env file is gitignored,
# so your secrets never get committed.
#
# Quotes are optional and stray ones are stripped, so you cannot get this
# wrong the way a .bat file lets you. Just paste the URL after the "=".

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME
# Dedicated controller channel. If omitted, controller alerts safely fall
# back to DISCORD_WEBHOOK_URL instead of disappearing.
CONTROLLER_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Optional - Pushover (overrides silent mode, re-alerts until acknowledged)
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# Optional - independent retailer workers (seconds)
# TARGET_INTERVAL=25
# GAMESTOP_INTERVAL=25
# NINTENDO_INTERVAL=25
# CONTROLLER_TARGET_INTERVAL=25
# CONTROLLER_GAMESTOP_INTERVAL=25
# CONTROLLER_NINTENDO_INTERVAL=25
# CONTROLLER_BESTBUY_INTERVAL=60
# ENABLE_WALMART=0
# ENABLE_BESTBUY=0
# ENABLE_COSTCO=0
# ENABLE_CONTROLLER_TARGET=1
# ENABLE_CONTROLLER_GAMESTOP=1
# ENABLE_CONTROLLER_NINTENDO=1
# ENABLE_CONTROLLER_BESTBUY=1

# Optional - external dead-man service such as healthchecks.io
# HEALTHCHECK_URL=

# Keep a Mac awake while the monitor is running (does not override lid-close sleep).
# PREVENT_MACOS_SLEEP=1
